APP_NAME=AnyWhereRoles
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/anywhereroles-laravel-main/public

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=anywhereroles
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@anywhereroles.com"
MAIL_FROM_NAME="${APP_NAME}"

# Resend Email Configuration (Optional - set API key if using Resend)
RESEND_API_KEY=
RESEND_DOMAIN=anywhereroles.in

# Cloudflare R2 Cloud Storage Configuration
# To use R2 as default storage, set: FILESYSTEM_DISK=r2
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=anywhereroles
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_URL=https://pub-<hash>.r2.dev
CLOUDFLARE_R2_USE_PATH_STYLE_ENDPOINT=false
