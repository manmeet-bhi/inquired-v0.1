APP_NAME=inaquired
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/anywhereroles-v0.1/public
APP_TIMEZONE=Asia/Kolkata

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=anywhereroles
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
FILESYSTEM_DISK=r2
QUEUE_CONNECTION=database

MAIL_MAILER=resend
MAIL_FROM_ADDRESS="noreply@inaquired.in"
MAIL_FROM_NAME="${APP_NAME}"

# Resend Email Configuration
RESEND_API_KEY=
RESEND_DOMAIN=noreply.inaquired.in

# Cloudflare R2 Cloud Storage Configuration
# Default storage disk: FILESYSTEM_DISK=r2
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_TOKEN=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=inaquired-r2
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_ENDPOINT=
# Optional: Public CDN URL (leave empty to serve media dynamically via /media route)
CLOUDFLARE_R2_URL=
CLOUDFLARE_R2_USE_PATH_STYLE_ENDPOINT=false
